---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { withBase } from '../lib/path';

// Anchor links (#xxx) only work on the home page. When the user is on
// /contacto and clicks "Servicios", we want them to jump to home and then
// to the anchor — so we prepend the home URL.
const isHome = Astro.url.pathname === withBase('') || Astro.url.pathname === withBase('/');
const anchor = (id: string) => (isHome ? `#${id}` : `${withBase('')}#${id}`);
---
<header class="sticky top-0 z-40 backdrop-blur bg-white/80 dark:bg-[color:var(--surface-bg)]/80 border-b border-navy/5 dark:border-cream/10">
  <nav class="max-w-6xl mx-auto px-5 py-3 flex items-center justify-between gap-4">
    <a href={withBase('')} aria-label="Inicio">
      <Logo size="sm" />
    </a>

    <ul class="hidden md:flex items-center gap-7 text-sm font-semibold text-navy-soft dark:text-cream/80">
      <li><a href={anchor('servicios')} class="hover:text-teal transition-colors">Servicios</a></li>
      <li><a href={anchor('galeria')} class="hover:text-teal transition-colors">Galería</a></li>
      <li><a href={anchor('ubicacion')} class="hover:text-teal transition-colors">Ubicación</a></li>
      <li><a href={withBase('contacto')} class="hover:text-teal transition-colors">Contacto</a></li>
    </ul>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <div class="hidden sm:block">
        <WhatsAppButton variant="primary" message="general" label="WhatsApp" class="!py-2 !px-4 !text-sm" />
      </div>
      <button
        type="button"
        class="md:hidden grid place-items-center w-10 h-10 rounded-xl bg-paper dark:bg-navy-soft text-navy dark:text-cream"
        aria-label="Abrir menú"
        data-mobile-toggle
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </nav>

  <div class="md:hidden hidden px-5 pb-4" data-mobile-menu>
    <ul class="flex flex-col gap-2 text-sm font-semibold text-navy-soft dark:text-cream/80">
      <li><a href={anchor('servicios')} class="block py-2">Servicios</a></li>
      <li><a href={anchor('galeria')} class="block py-2">Galería</a></li>
      <li><a href={anchor('ubicacion')} class="block py-2">Ubicación</a></li>
      <li><a href={withBase('contacto')} class="block py-2">Contacto</a></li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
